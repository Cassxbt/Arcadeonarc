# ============================================================================
# ARCade on Arc - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ============================================================================

# ============================================================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================================================

# Session secret for JWT signing (REQUIRED)
# Generate with: openssl rand -hex 32
# WARNING: Must be different from SIGNER_PRIVATE_KEY
SESSION_SECRET=

# Private key for signing game outcomes and vault transactions (REQUIRED)
# Format: 0x followed by 64 hex characters
# WARNING: Must be different from SESSION_SECRET
SIGNER_PRIVATE_KEY=

# Dynamic Labs environment ID (REQUIRED for wallet auth)
# Get from: https://app.dynamic.xyz/ → Settings → General → Environment ID
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# ============================================================================
# DATABASE - SUPABASE (REQUIRED)
# ============================================================================

# Supabase project URL (REQUIRED)
# Format: https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (REQUIRED)
# Used for client-side database access with RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (REQUIRED)
# WARNING: This key bypasses Row Level Security - keep it secret!
# Only use server-side, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# REDIS - UPSTASH (REQUIRED FOR RATE LIMITING)
# ============================================================================

# Upstash Redis REST API URL (REQUIRED)
# Get from: https://console.upstash.com/
KV_REST_API_URL=

# Upstash Redis REST API token (REQUIRED)
# Get from: https://console.upstash.com/
KV_REST_API_TOKEN=

# ============================================================================
# CRON JOBS (REQUIRED FOR SCHEDULED TASKS)
# ============================================================================

# Secret for authenticating cron job requests (REQUIRED)
# Generate with: openssl rand -hex 32
# Used by Vercel Cron to trigger weekly distributions
CRON_SECRET=

# ============================================================================
# BLOCKCHAIN RPC (OPTIONAL - HAS DEFAULTS)
# ============================================================================

# Arc Testnet RPC URL (OPTIONAL)
# Default: https://rpc.testnet.arc.network
# ARC_RPC_URL=https://rpc.testnet.arc.network

# ============================================================================
# DEPLOYMENT (OPTIONAL)
# ============================================================================

# Your production site URL (OPTIONAL - for CORS)
# Default: https://arcade-on-arc.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Node environment (auto-set by Vercel)
# NODE_ENV=production

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================
#
# 1. Copy this file: cp .env.example .env.local
# 2. Generate SESSION_SECRET: openssl rand -hex 32
# 3. Generate SIGNER_PRIVATE_KEY: Use MetaMask or cast wallet new
# 4. Generate CRON_SECRET: openssl rand -hex 32
# 5. Create Supabase project: https://supabase.com/dashboard
# 6. Create Upstash Redis: https://console.upstash.com/
# 7. Get Dynamic Labs key: https://app.dynamic.xyz/
# 8. Verify all REQUIRED variables are set
# 9. Run: npm run dev
#
# ============================================================================
# SECURITY REMINDERS
# ============================================================================
#
# ✓ Never commit .env.local to git
# ✓ Never reuse SESSION_SECRET as SIGNER_PRIVATE_KEY
# ✓ Never expose SUPABASE_SERVICE_ROLE_KEY to client
# ✓ Rotate secrets regularly in production
# ✓ Use different values for dev/staging/production
# ✓ Fund signer wallet with enough gas for settlements
#
# ============================================================================
